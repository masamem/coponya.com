{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run check && pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!assets/|brand/|fonts/|_vercel/).*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  }
}
